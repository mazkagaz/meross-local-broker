#!/usr/bin/with-contenv bashio
source /opt/utils/bashutils.sh

ADVERTISE=$(get_option 'advertise' 'false')
if [[ $ADVERTISE == "true" ]]; then
    # Advertise the HTTPS listener: HTTP on the ingress port is restricted to
    # the Supervisor and cannot be reached by phones on the LAN.
    bashio::log.info "Advertising the Meross API service"
    https_port=$(bashio::app.port 2004)
    https_port=${https_port:-"2004"}
    host_err=$(mktemp)
    host_ips=$(python3 /opt/custom_broker/supervisor_network.py 2>"$host_err" || true)

    txt_args=("https_port=$https_port")
    if [[ -n $host_ips ]]; then
        txt_args+=("host=$host_ips")
    else
        bashio::log.warning "No LAN IPv4 address found; advertising without host TXT record."
        if [[ -s $host_err ]]; then
            bashio::log.warning "supervisor_network: $(cat "$host_err")"
        fi
    fi
    rm -f "$host_err"
    bashio::log.info "API mDNS: service_port=$https_port https_port=$https_port host=$host_ips"
    /opt/custom_broker/mdns_register.py register meross_local_api meross_local_api _meross-api._tcp $https_port --update-if-present --set "${txt_args[@]}"
else
    bashio::log.warning "Advertising disabled. The Meross API service won't be advertised via MDNS."
fi

# ==============================================================================
# Start meross API service
# ==============================================================================
bashio::log.info "Starting the Meross daemon SERVICE"
exec 2>&1
exec /usr/local/bin/api.sh
