# Copy to .env and adjust. install.sh creates it automatically.
BROKER_IMAGE=ghcr.io/mazkagaz/amd64-meross_local_broker:latest
ADVERTISE=false
DEBUG_MODE=false
DEVICE_TIMEZONE=
MQTT_INTEGRITY_MODE=observe

# Admin UI: loopback only by default. Use an SSH tunnel to reach it remotely.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=2003
ADMIN_ALLOW_CIDR=127.0.0.1

# TLS SANs: 1 detects the host IPv4 addresses with network_mode: host.
TLS_SAN_AUTO=1
# Add extra IPs or DNS names, comma separated (e.g. 192.168.1.10,broker.local).
TLS_SAN_EXTRA=
