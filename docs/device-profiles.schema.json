{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mazkagaz/meross-local-broker/docs/device-profiles.schema.json",
  "title": "Meross Local device profile (v2)",
  "description": "Declarative description of a Meross device: identity, payloads, entities, polling and typed quirks. Data only: never executed. Evolution policy: additive optional fields keep the major version; only breaking changes increment schema_version. Profiles may declare schema_version 1 or 2; the engine applies defaults. Unknown x-* keys are preserved; unknown core keys are rejected.",
  "type": "object",
  "required": ["schema_version", "profile", "match", "entities"],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": true
  },
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string"
        },
        "requires_engine": {
          "type": "string",
          "description": "Minimum engine version, e.g. '>=2.0'."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "match": {
      "$ref": "#/$defs/match"
    },
    "payloads": {
      "$ref": "#/$defs/payloads"
    },
    "entities": {
      "$ref": "#/$defs/entities"
    },
    "subdevices": {
      "type": "array",
      "description": "Hub templates: each match selects a subdevice type and compiles its own entities.",
      "items": {
        "$ref": "#/$defs/subdevice"
      }
    },
    "quirks": {
      "$ref": "#/$defs/quirks"
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "kind": {
          "enum": ["device", "hub", "any"],
          "default": "device"
        },
        "type": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sub_type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mac_prefix": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{2}([0-9A-Fa-f]{2})*$"
          }
        },
        "abilities": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x-": true
          },
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "any": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "polling": {
      "type": "object",
      "description": "How the engine polls this namespace. Omitted fields use engine defaults.",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["default", "smart", "once", "chunked"]
        },
        "period_s": {
          "type": "number",
          "minimum": 0
        },
        "push": {
          "type": "boolean",
          "description": "When true, MQTT pushes suppress periodic polling."
        },
        "response_size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "type": {
          "enum": ["integer", "number", "string", "boolean", "object", "array"]
        },
        "unit": {
          "type": "string"
        },
        "scale": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "values": {
          "type": "object",
          "description": "Optional enumeration: raw value -> semantic name.",
          "additionalProperties": true
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "items": {
          "$ref": "#/$defs/field"
        }
      }
    },
    "payloads": {
      "type": "object",
      "description": "Observed/supported namespaces and field descriptions.",
      "additionalProperties": {
        "type": "object",
        "required": ["methods"],
        "additionalProperties": false,
        "patternProperties": {
          "^x-": true
        },
        "properties": {
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["GET", "SET", "GETACK", "SETACK", "PUSH", "ERROR"]
            }
          },
          "digest": {
            "type": "string",
            "description": "Path of the digest document inside the payload, if any."
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/field"
            }
          },
          "polling": {
            "$ref": "#/$defs/polling"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "subdevice": {
      "type": "object",
      "required": ["match", "entities"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "match": {
          "$ref": "#/$defs/match"
        },
        "name": {
          "type": "string"
        },
        "payloads": {
          "$ref": "#/$defs/payloads"
        },
        "entities": {
          "$ref": "#/$defs/entities"
        },
        "quirks": {
          "$ref": "#/$defs/quirks"
        }
      }
    },
    "quirk": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "quirks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quirk"
      }
    },
    "state": {
      "type": "object",
      "required": ["namespace"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "namespace": {
          "type": "string"
        },
        "channel": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "digest": {
          "type": "string",
          "description": "Path of the digest document when the state is carried by System.All."
        },
        "fields": {
          "type": "object",
          "description": "Entity property -> path inside the payload (e.g. 'togglex[0].onoff').",
          "additionalProperties": {
            "type": "string"
          }
        },
        "scale": {
          "type": "number"
        }
      }
    },
    "command": {
      "type": "object",
      "required": ["namespace", "payload"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "namespace": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        },
        "value_scale": {
          "type": "number",
          "description": "Multiplier applied to $value before sending."
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Optional structured capabilities for complex platforms. Extend additively.",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hvac_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preset_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fan_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "swing_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_temp": {
          "type": "number"
        },
        "max_temp": {
          "type": "number"
        },
        "temp_step": {
          "type": "number"
        },
        "target_humidity": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entity_base": {
      "type": "object",
      "required": ["key", "platform"],
      "patternProperties": {
        "^x-": true
      },
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "platform": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "channel": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "device": {
          "enum": ["hub", "subdevice"],
          "default": "hub"
        },
        "device_class": {
          "type": "string"
        },
        "entity_category": {
          "enum": ["config", "diagnostic"]
        },
        "unit": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/command"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "quirks": {
          "$ref": "#/$defs/quirks"
        }
      }
    },
    "entity_simple": {
      "allOf": [
        {
          "$ref": "#/$defs/entity_base"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "enum": [
            "cover",
            "switch",
            "light",
            "sensor",
            "binary_sensor",
            "number",
            "button",
            "select"
          ]
        }
      }
    },
    "entity_climate": {
      "allOf": [
        {
          "$ref": "#/$defs/entity_base"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "const": "climate"
        }
      },
      "required": ["capabilities"]
    },
    "entity_fan": {
      "allOf": [
        {
          "$ref": "#/$defs/entity_base"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "const": "fan"
        }
      },
      "required": ["capabilities"]
    },
    "entity_humidifier": {
      "allOf": [
        {
          "$ref": "#/$defs/entity_base"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "const": "humidifier"
        }
      }
    },
    "entity_calendar": {
      "allOf": [
        {
          "$ref": "#/$defs/entity_base"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "const": "calendar"
        }
      }
    },
    "entity_media_player": {
      "allOf": [
        {
          "$ref": "#/$defs/entity_base"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "const": "media_player"
        }
      }
    },
    "entity_siren": {
      "allOf": [
        {
          "$ref": "#/$defs/entity_base"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "const": "siren"
        }
      }
    },
    "entity_update": {
      "allOf": [
        {
          "$ref": "#/$defs/entity_base"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "platform": {
          "const": "update"
        }
      }
    },
    "entity": {
      "oneOf": [
        {
          "$ref": "#/$defs/entity_simple"
        },
        {
          "$ref": "#/$defs/entity_climate"
        },
        {
          "$ref": "#/$defs/entity_fan"
        },
        {
          "$ref": "#/$defs/entity_humidifier"
        },
        {
          "$ref": "#/$defs/entity_calendar"
        },
        {
          "$ref": "#/$defs/entity_media_player"
        },
        {
          "$ref": "#/$defs/entity_siren"
        },
        {
          "$ref": "#/$defs/entity_update"
        }
      ]
    }
  }
}
