{
  "name": "meross-local-broker",
  "version": "1.1.3",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "npm run write:env -s && ng build --configuration production --base-href ./ --output-path=../rootfs/var/www",
    "start": "npm run write:env -s && ng serve",
    "test": "npm run write:env -s && ng test",
    "test:ci": "npm run write:env -s && ng test --configuration=ci",
    "write:env": "node scripts/write-env.js",
    "prettier": "prettier --write \"./src/**/*.{ts,js,html,scss}\"",
    "prettier:check": "prettier --list-different \"./src/**/*.{ts,js,html,scss}\"",
    "postinstall": "npm run prettier -s",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/localize": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@ngx-translate/core": "^17.0.0",
    "angularx-qrcode": "^22.0.1",
    "codemirror": "^6.0.2",
    "material-design-icons-iconfont": "^6.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular/build": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@ngneat/until-destroy": "^10.0.0",
    "@types/jasmine": "^3.6.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "husky": "^4.3.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~3.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-jasmine": "~4.0.1",
    "karma-junit-reporter": "^2.0.1",
    "prettier": "^2.2.1",
    "pretty-quick": "^3.1.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.scss",
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
